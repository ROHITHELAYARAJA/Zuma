{
  "name": "clinical-interoperability-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n hospital-a,hospital-b,api,web \"npm:dev:hospital-a\" \"npm:dev:hospital-b\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --import tsx server/index.ts",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && next build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "skills:sync": "node scripts/import-skills.mjs",
    "start:web": "next start --hostname 127.0.0.1 --port 3000",
    "dev:services": "concurrently -k -n hospital-a,hospital-b,api \"npm:dev:hospital-a\" \"npm:dev:hospital-b\" \"npm:dev:api\"",
    "dev:hospital-a": "tsx hospitals/launch.ts A",
    "dev:hospital-b": "tsx hospitals/launch.ts B",
    "seed:samples": "tsx infrastructure/aws/seed-samples.ts",
    "aws:kb": "tsx infrastructure/aws/provision-knowledge-base.ts",
    "abdm:data": "tsx scripts/prepare-abdm-data.ts",
    "abdm:up": "docker compose -f infrastructure/abdm/compose.yaml up -d --build",
    "abdm:down": "docker compose -f infrastructure/abdm/compose.yaml down",
    "abdm:flow": "tsx scripts/abdm-flow.ts",
    "abdm:upload": "tsx scripts/upload-abdm-evidence.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.1152.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "latest",
    "@aws-sdk/client-s3": "latest",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "latest",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@gsap/react": "latest",
    "@hono/node-server": "latest",
    "@react-three/drei": "latest",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "latest",
    "hono": "^4.13.13",
    "lucide-react": "latest",
    "motion": "latest",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "latest",
    "tw-animate-css": "1.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "concurrently": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
